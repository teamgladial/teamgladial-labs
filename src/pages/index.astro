---
const projects = [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Experiments, prototypes, and open-source projects from Gladial Labs." />
    <meta name="theme-color" content="#111916" />
    <title>Labs | Gladial</title>
  </head>
  <body>
    <main>
      <header><a class="brand" href="https://gladial.com"><span class="symbol">G</span> GLADIAL</a><a class="back" href="https://gladial.com">← Gladial home</a></header>
      <section class="hero">
        <p class="eyebrow"><span></span> THE WORKSHOP</p>
        <h1>Curiosity,<br /><i>put to work.</i></h1>
        <p class="intro">A home for experiments, useful tools, and open-source projects. Some ideas grow into products; others are worth sharing just as they are.</p>
      </section>
      <section class="work" aria-labelledby="work-heading">
        <div class="section-heading"><h2 id="work-heading">Selected work</h2><span>PROJECTS &amp; EXPERIMENTS</span></div>
        {projects.length ? <div class="grid">{projects.map((project) => <article class="card"><p class="tag">{project.tag}</p><h3>{project.name}</h3><p>{project.description}</p><a href={project.url}>Explore project ↗</a></article>)}</div> : <div class="empty"><span class="orbit">✳</span><div><h3>The workbench is being set up.</h3><p>Projects and experiments will find their way here. In the meantime, browse the source on GitHub.</p><a href="https://github.com/teamgladial">Visit Gladial on GitHub ↗</a></div></div>}
      </section>
      <footer><span>Independent experiments by Gladial.</span><a href="https://gladial.com">gladial.com ↗</a></footer>
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#111916;color:#edf1e9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}main{width:min(940px,calc(100% - 48px));margin:auto}a{color:inherit;text-decoration:none}header{height:84px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #29342e}.brand{display:flex;align-items:center;gap:11px;color:#bac7ba;font-size:11px;font-weight:700;letter-spacing:.18em}.symbol{width:28px;height:28px;display:grid;place-items:center;border:1px solid #526452;border-radius:50%;font-family:Georgia,serif;font-size:16px;letter-spacing:0;color:#d1dfc3}.back{font-size:13px;color:#9ba99c}.hero{padding:clamp(84px,13vw,148px) 0 102px;max-width:740px}.eyebrow,.section-heading span,.tag{font-size:10px;font-weight:700;letter-spacing:.17em;color:#a3b29b}.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow span{width:7px;height:7px;background:#a9c281;border-radius:50%}h1{margin:29px 0 23px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(58px,10vw,104px);font-weight:400;line-height:.94;letter-spacing:-.065em}h1 i{color:#aec78d;font-weight:400}.intro{max-width:550px;color:#a4afa6;font-size:17px;line-height:1.75}.section-heading{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px;border-bottom:1px solid #29342e}.section-heading h2{margin:0;font-size:17px;font-weight:500}.section-heading span{color:#758378}.empty{display:flex;gap:23px;align-items:flex-start;padding:44px 0 60px}.orbit{color:#aec78d;font-size:25px}.empty h3{margin:1px 0 9px;font-family:Georgia,serif;font-size:25px;font-weight:400}.empty p{max-width:480px;margin:0 0 18px;color:#9ba79d;line-height:1.65}.empty a{font-size:13px;color:#d0dfa9;border-bottom:1px solid #82976b;padding-bottom:4px}footer{display:flex;justify-content:space-between;padding:22px 0 30px;border-top:1px solid #29342e;color:#859188;font-size:12px}footer a{color:#bdc9bd}@media(max-width:560px){.section-heading{align-items:flex-start;gap:12px;flex-direction:column}.hero{padding-bottom:80px}}
</style>
